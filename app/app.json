{
  "expo": {
    "name": "QuestHabit",
    "slug": "questhabit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "questhabit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.questhabit.app",
      "infoPlist": {
        "NSCameraUsageDescription": "QuestHabit uses the camera for your profile photo.",
        "NSPhotoLibraryUsageDescription": "QuestHabit accesses your photos for your profile."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.questhabit.app",
      "permissions": ["NOTIFICATIONS", "VIBRATE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#06B6D4",
          "defaultChannel": "habit-reminders",
          "sounds": []
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.questhabit.app",
          "widgets": [
            {
              "name": "HabitProgressWidget",
              "displayName": "Daily Progress",
              "description": "Track your daily habit completion at a glance",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            },
            {
              "name": "StreakWidget",
              "displayName": "Streak Tracker",
              "description": "Keep an eye on your habit streaks",
              "supportedFamilies": ["systemSmall", "accessoryCircular"]
            },
            {
              "name": "LevelWidget",
              "displayName": "Level Progress",
              "description": "See your XP and level progress",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}

